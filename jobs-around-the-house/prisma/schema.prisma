// Prisma schema for Jobs Around The House
// Using SQLite for development, PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// Service Categories (Multi-level taxonomy)
// ============================================
model Category {
  id          Int         @id @default(autoincrement())
  parentId    Int?        @map("parent_id")
  name        String
  slug        String      @unique
  description String?
  imageUrl    String?     @map("image_url")
  isActive    Boolean     @default(true) @map("is_active")
  sortOrder   Int         @default(0) @map("sort_order")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  parent      Category?   @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[]  @relation("CategoryToCategory")
  products    Product[]
  heroImages  HeroImage[]

  @@map("categories")
}

// ============================================
// Service Products (Master catalog inventory detailing baseline gross VAT parameters)
// ============================================
model Product {
  id            Int               @id @default(autoincrement())
  categoryId    Int               @map("category_id")
  sku           String            @unique
  title         String
  slug          String            @unique
  description   String?
  imageUrl      String?           @map("image_url")
  basePrice     Float             @map("base_price")
  vatRate       Float             @default(20.00) @map("vat_rate")
  stockQuantity Int               @map("stock_quantity")
  productType   String            @default("standard") @map("product_type") // standard, workflow_parent, virtual_bundle
  isActive      Boolean           @default(true) @map("is_active")
  sortOrder     Int               @default(0) @map("sort_order")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  workflowSteps WorkflowStep[]
  optionsLinked StepOption[]      @relation("OptionProduct")
  bundleComponents BundleComponent[] @relation("BundleProduct")
  componentOf   BundleComponent[] @relation("ComponentProduct")
  heroImages    HeroImage[]
  orderItems    OrderItem[]

  @@map("products")
}

// ============================================
// Workflow Steps (Step configuration paths supporting branching flags)
// ============================================
model WorkflowStep {
  id                      Int                     @id @default(autoincrement())
  parentProductId         Int                     @map("parent_product_id")
  stepName                String                  @map("step_name")
  sortOrder               Int                     @map("sort_order")
  isMandatory             Boolean                 @default(true) @map("is_mandatory")
  conditionalTriggerValue String?                 @map("conditional_trigger_value")
  
  // Custom operational fields required by application
  fieldType               String                  @default("text") @map("field_type") // number | select | boolean | text | dimensions | photo_upload
  fieldKey                String                  @map("field_key")
  helpText                String?                 @map("help_text")
  unit                    String?                 // m² | m | items | hours
  validationRules         String?                 @map("validation_rules") // JSON string

  product                 Product                 @relation(fields: [parentProductId], references: [id], onDelete: Cascade)
  options                 StepOption[]
  responses               OrderWorkflowResponse[]

  @@map("workflow_steps")
}

// ============================================
// Workflow Step Options (Individual step selections mapping to upsell items)
// ============================================
model StepOption {
  id               Int          @id @default(autoincrement())
  stepId           Int          @map("step_id")
  productId        Int?         @map("product_id") // Links option to real item or service SKU
  priceModifier    Float        @default(0.00) @map("price_modifier")
  optionValueFlag  String       @map("option_value_flag") // e.g. "no_base_supplied"

  // Custom operational fields required by application
  label            String
  value            String
  description      String?
  sortOrder        Int          @default(0) @map("sort_order")

  step             WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  product          Product?     @relation("OptionProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@map("workflow_step_options")
}

// ============================================
// Order Workflow Responses (Captures custom entries, sizes, and file uploads)
// ============================================
model OrderWorkflowResponse {
  id                   Int          @id @default(autoincrement())
  orderId              Int          @map("order_id")
  stepId               Int          @map("step_id")
  customerTextResponse String?      @map("customer_text_response")
  uploadedPhotoUrl     String?      @map("uploaded_photo_url")

  order                Booking      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  step                 WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@map("order_workflow_responses")
}

// ============================================
// Bundle Components (Virtual bundling map)
// ============================================
model BundleComponent {
  id                 Int     @id @default(autoincrement())
  bundleProductId    Int     @map("bundle_product_id") // Type must be 'virtual_bundle'
  componentProductId Int     @map("component_product_id") // The single child item
  quantity           Int

  bundle             Product @relation("BundleProduct", fields: [bundleProductId], references: [id], onDelete: Cascade)
  component          Product @relation("ComponentProduct", fields: [componentProductId], references: [id], onDelete: Cascade)

  @@map("bundle_components")
}

// ============================================
// Order Items (Historical sales snapshot log providing source data for manual finance input)
// ============================================
model OrderItem {
  id                  Int     @id @default(autoincrement())
  orderId             Int     @map("order_id")
  sku                 String
  quantity            Int
  grossUnitPrice      Float   @map("gross_unit_price")
  vatRateApplied      Float   @map("vat_rate_applied")
  vatAmountTotal      Float   @map("vat_amount_total")
  legalWaiverInjected String? @map("legal_waiver_injected")

  order               Booking @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product @relation(fields: [sku], references: [sku])

  @@map("order_items")
}

// ============================================
// Hero Carousel Images
// ============================================
model HeroImage {
  id         Int      @id @default(autoincrement())
  categoryId Int?     @map("category_id")
  productId  Int?     @map("product_id")
  imageUrl   String   @map("image_url")
  filename   String
  isActive   Boolean  @default(false) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("hero_images")
}

// ============================================
// Customers
// ============================================
model Customer {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  phone        String?
  addressLine1 String?   @map("address_line_1")
  addressLine2 String?   @map("address_line_2")
  city         String?
  postcode     String?
  hasAccount   Boolean   @default(false) @map("has_account")
  passwordHash String?   @map("password_hash")
  loyaltyPoints Int      @default(0) @map("loyalty_points")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  bookings     Booking[]

  @@map("customers")
}

// ============================================
// Bookings (Master orders ledger data table)
// ============================================
model Booking {
  id              Int       @id @default(autoincrement())
  customerId      Int       @map("customer_id")
  status          String    @default("pending") // pending | confirmed | in_progress | completed | cancelled
  preferredDate   DateTime? @map("preferred_date")
  preferredTime   String?   @map("preferred_time")
  subtotal        Float     @default(0)
  wasteCost       Float     @default(0) @map("waste_cost")
  accessSurcharge Float     @default(0) @map("access_surcharge")
  total           Float     @default(0)
  depositAmount   Float     @default(0) @map("deposit_amount")
  remainingAmount Float     @default(0) @map("remaining_amount")
  stripePaymentId String?   @map("stripe_payment_id")
  paymentStatus   String    @default("unpaid") @map("payment_status") // unpaid | deposit_paid | fully_paid | refunded | partial_refund
  notes           String?
  customerNotes   String?   @map("customer_notes")
  cancellationReason String? @map("cancellation_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  customer          Customer                @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  workflowResponses OrderWorkflowResponse[]

  @@map("bookings")
}

// ============================================
// Admin Users
// ============================================
model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("admin") // admin | super_admin
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

// ============================================
// Global Pricing Variables
// ============================================
model PricingVariable {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  label       String
  value       Float
  unit        String?  // £ | % | multiplier
  category    String?  // waste | labour | travel
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("pricing_variables")
}

